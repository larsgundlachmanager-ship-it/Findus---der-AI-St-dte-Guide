{
  "expo": {
    "name": "Findus",
    "slug": "findus",
    "version": "2.0.2",
    "owner": "findusai",
    "scheme": "findus",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#18181B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "de.findus.app",
      "buildNumber": "17",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Findus nutzt deinen Standort, um Tour-Stops in der Nähe zu erkennen.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Findus braucht auch im Hintergrund und bei gesperrtem Bildschirm deinen Standort, damit die Tour weiterläuft.",
        "NSLocationAlwaysUsageDescription": "Findus braucht auch im Hintergrund und bei gesperrtem Bildschirm deinen Standort, damit die Tour weiterläuft.",
        "UIBackgroundModes": [
          "location",
          "audio"
        ],
        "NSMicrophoneUsageDescription": "Findus braucht das Mikrofon für deine Rückfragen.",
        "NSSpeechRecognitionUsageDescription": "Findus wandelt deine Sprache in Text um.",
        "NSPhotoLibraryUsageDescription": "Findus greift nicht aktiv auf deine Fotomediathek zu. Diese Angabe ist erforderlich, weil eingebundene Bibliotheken die Foto-API referenzieren können.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Findus nutzt die Kamera nur für die Taschenlampe (Torch), nicht für Fotos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#18181B"
      },
      "package": "de.findus.app",
      "versionCode": 25,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "findus"
            },
            {
              "scheme": "de.findus.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "findus",
              "host": "auth",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "findus",
              "host": "voice",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "ASSIST",
          "category": [
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "com.android.alarm.permission.SET_ALARM",
        "VIBRATE"
      ]
    },
    "plugins": [
      "./plugins/withJetifier",
      "./plugins/withFindusEspeak",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Findus nutzt deinen Standort, um Tour-Stops in der Nähe zu erkennen.",
          "locationAlwaysAndWhenInUsePermission": "Findus braucht auch im Hintergrund und bei gesperrtem Bildschirm deinen Standort, damit die Tour weiterläuft.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C4A35A",
          "sounds": [],
          "defaultChannel": "findus-departure-reminders"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Findus braucht das Mikrofon für deine Rückfragen."
        }
      ],
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Findus braucht das Mikrofon für deine Rückfragen.",
          "speechRecognitionPermission": "Findus wandelt deine Sprache in Text um.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "208487d8-640a-47d8-b77e-5ece29680839"
      }
    }
  }
}
