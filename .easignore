# EAS upload ignore — keep archive small (was 1.6 GB)
# https://expo.fyi/eas-build-archive

# deps / tooling (reinstalled on EAS)
node_modules/
.expo/
.tools/
.git/

# local build outputs
dist/
releases/
android/app/build/
android/.gradle/
android/build/
**/.cxx/
**/build/
**/.gradle/

# large local-only / not needed for cloud build
website/
docs/
/data/
.cursor/
.phone-check/
.tmp/
.tmp-*/
.tmp-espeak/
.tmp-subtitle-frames/
.tmp-screen-review/
agent-transcripts/
# Nur Root-Store-Listings (nicht src/store — sonst bricht der JS-Bundle)
/store/
tmp-*.png
tmp-*.jpg
*.log

# local Android intermediates (EAS re-prebuilds / uses clean tree)
android/app/.cxx/
android/.gradle/
android/app/build/
android/build/

# Stadt-Cover nur für Upload-Pipelines — App lädt HTTPS-Cover (nicht bundeln)
assets/onboarding/remote-covers/
assets/onboarding/*-soft.png
assets/onboarding/city-*.png
!assets/onboarding/city-card-hero.jpg

# packages / binaries
*.aab
*.apk
*.gguf
*.onnx
!native-assets/kokoro/*.onnx

# secrets / signing (EAS credentials server-side)
android/keystore.properties
*.keystore
!android/app/debug.keystore
*.jks
.env
.env.*
*.p8
*.p12
*.mobileprovision

credentials.json
*service-account*.json
google-play-*.json
pc-api-*.json

# Dev-Audio / Drafts — nicht in EAS-Archive (APK schlank)
src/assets/audio/samples/
src/assets/audio/_female_audit/
assets/brand/
assets/_icon-crops/
assets/onboarding/map-bg.png
assets/onboarding/phone-mockup.png
assets/onboarding/findus-*.png
assets/onboarding/yorro-*.png
assets/onboarding/_*-cover-source.png
assets/icon-*.png
assets/_*.py
