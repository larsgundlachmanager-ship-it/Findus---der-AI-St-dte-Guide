    "install:android:release": "powershell -ExecutionPolicy Bypass -File ./scripts/install-release-apk.ps1",
    "build:ios:store": "npx eas-cli build --platform ios --profile production --non-interactive",
    "ios": "expo run:ios",
    "web": "expo start --web",
