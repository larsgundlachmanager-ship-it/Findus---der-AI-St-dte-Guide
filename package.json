    "@babel/core": "^7.26.0",
    "@expo/config-plugins": "^57.0.5",
    "@types/jszip": "^3.4.0",
    "@types/react": "~18.3.12",
    "patch-package": "^8.0.1",
    "sharp": "^0.34.5",
    "typescript": "~5.3.3"
  },
  "private": true
}
