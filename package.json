    "expo-sensors": "~14.0.2",
    "expo-speech": "~13.0.1",
    "expo-speech-recognition": "^1.1.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-task-manager": "~12.0.6",
    "expo-web-browser": "14.0.2",
    "findus-espeak": "file:modules/findus-espeak",
    "jszip": "^3.10.1",
    "llama.rn": "^0.5.11",
    "phonemizer": "^1.2.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
