    "city:directory": "node scripts/cityPack/expandCityDirectory.mjs",
    "city:classify": "node scripts/cityPack/classifyPackCategories.mjs",
    "city:research-gaps": "node scripts/cityPack/reportResearchGaps.mjs",
    "city:gate": "node scripts/cityPack/runQualityGate.mjs",
    "city:auto": "node scripts/cityPack/createCityAuto.mjs",
    "city:wiki": "node scripts/cityPack/enrichFromWikipedia.mjs",
