# Gemini 1.5 Flash — Text-Engine (POI-Stories & Rückfragen)
# P0 empfohlen: Keys NUR serverseitig (Supabase Secrets) + Proxy:
#   EXPO_PUBLIC_USE_LLM_PROXY=1
#   supabase secrets set GEMINI_API_KEY=... CARTESIA_API_KEY=...
#   supabase functions deploy gemini-proxy
#   supabase functions deploy cartesia-proxy
# Dann Client-Keys leer lassen / nicht bundlen.
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-key-here
# EXPO_PUBLIC_USE_LLM_PROXY=1
# Optional Overrides:
# EXPO_PUBLIC_GEMINI_PROXY_URL=https://your-project.supabase.co/functions/v1/gemini-proxy
# EXPO_PUBLIC_CARTESIA_PROXY_URL=https://your-project.supabase.co/functions/v1/cartesia-proxy

# Cartesia sonic-3.5 — primäre Cloud-TTS (Yorro-Stimmen)
EXPO_PUBLIC_CARTESIA_API_KEY=your-cartesia-key-here
# Optional: Pronunciation Dictionary aus dem Cartesia-Playground (gilt für alle Stimmen)
# EXPO_PUBLIC_CARTESIA_PRONUNCIATION_DICT_ID=

# OpenAI (optionaler Chat-Fallback — TTS entfernt)
EXPO_PUBLIC_OPENAI_API_KEY=your-key-here

# Optionales lokales GGUF-Modell (llama.rn) — Offline-Fallback ohne Gemini
EXPO_PUBLIC_LOCAL_MODEL_PATH=

# Supabase (POI-/Fakten-Master + Auth)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# City-Pack Demand: ab 10 Unique-Usern in Soft-Stadt → Queue → city:auto + Upload
#   npm run city:demand:process  |  CI: city-pack-demand.yml
# Neue User-Orte → pack_spot_inbox → npm run city:spot:process (merge + wiki-depth + upload)
# Auth Redirects (Dashboard → Authentication → URL Configuration):
#   Site URL: findus://auth/callback
#   Additional Redirect URLs:
#     findus://auth/callback
#     findus://**
#     de.findus.app://auth/callback

# OpenWeatherMap One Call API 3.0 (Modul-4 Wetter-Tracker, minutely Regen)
# EXPO_PUBLIC_OPENWEATHER_API_KEY=your-openweather-key

# Optional: shared weather Edge Function (default = $SUPABASE_URL/functions/v1/weather-forecast)
# Caches Open-Meteo per city/geo-cell for 3h so 100 users in Hamburg → 1 upstream call.
# EXPO_PUBLIC_WEATHER_ENDPOINT=https://your-project.supabase.co/functions/v1/weather-forecast
# Nur für scripts/uploadCityPack.mjs (Storage-Write; nie in die App bundlen)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Google Maps für Scripts (Geocoding/Places/Street View Metadata)
# GOOGLE_MAPS_API_KEY=your-google-maps-key
# Pack-Bau: cheap (Default) = OSM-Directory, Google nur für Story-Suche + GPS-Pins.
# full = Places auch für Directory + Classify-Nachsuche (teuer, oft 10–50×).
# FINDUS_PACK_COST=cheap
# Script-Key von App-Key trennen; Places-Quota z.B. 400 Text-Searches/Tag.
# Runtime (App): Directions (walking/bike/transit) + Places + Geocoding + Street View
# für freihändige Landmarken-Navigation. Nie driving.
# APIs im Key aktivieren: Directions, Geocoding, Places, Street View Static + Metadata
# Street View: nutzt Static Images API (Quota/Billing je Google Cloud Projekt)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# ---------------------------------------------------------------------------
# ÖPNV Live + Mobility (optional)
# ---------------------------------------------------------------------------
# Google Maps Platform — Directions (walking/bike/transit) Fallback
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Transitous MOTIS 2 — primäres EU-ÖPNV-Routing + GTFS-RT Live-Verspätungen
# (kostenlos, Open Source; User-Agent wird vom Client gesetzt)
# EXPO_PUBLIC_TRANSITOUS_BASE_URL=https://api.transitous.org/api

# Deutsche Bahn / HAFAS (transport.rest braucht i. d. R. keinen Key;
# offizielle RIS-Keys NIEMALS als EXPO_PUBLIC_* — nur Server/Scripts)
# EXPO_PUBLIC_DB_CLIENT_ID=
# DB_CLIENT_SECRET=   # server-only, niemals EXPO_PUBLIC_
# EXPO_PUBLIC_DB_API_KEY=
# EXPO_PUBLIC_DB_HAFAS_BASE_URL=https://v6.db.transport.rest

# OSRM Directions — eigene Findus-Instanz mit foot/bike empfohlen
# Format: https://your-osrm.example/route/v1
# Leer → FOSSGIS Fuß/Rad (routing.openstreetmap.de/routed-foot|bike)
# Nie router.project-osrm.org für Fuß/Rad — nur Auto-Graph (keine Fußbrücken)
# EXPO_PUBLIC_OSRM_BASE=
# EXPO_PUBLIC_PREFER_GOOGLE_ROUTING=1

# FlightAware AeroAPI v4 (Header x-apikey) — Flugstatus, Gates, Verspätung
# EXPO_PUBLIC_FLIGHTAWARE_API_KEY=

# GTFS-Realtime TripUpdates — JSON-Proxy empfohlen (Protobuf braucht Decoder)
# EXPO_PUBLIC_GTFS_RT_URL=https://your-proxy.example/gtfs-rt.json
# De Lijn (Belgien) — nur für BE-Städte
# EXPO_PUBLIC_DELIJN_API_KEY=
# EXPO_PUBLIC_DELIJN_BASE_URL=https://api.delijn.be/gic/v1
# Parkopedia Partner (sonst: Google Places parking + Pack _mobility.parking)
# EXPO_PUBLIC_PARKOPEDIA_API_KEY=
# nextbike / Call a Bike: öffentliche Live-Map, kein Key nötig

# Stadt-Pack im Storage-Bucket `staedte` (Datei: <id>.json)
EXPO_PUBLIC_CITY_ID=prisdorf

# ---------------------------------------------------------------------------
# 3-Tier Tischreservierung (API → E-Mail → KI-Anruf)
# Alle optional — ohne Keys: Findus bietet nur Navigation / tel: an (keine Fake-Buchung)
# ---------------------------------------------------------------------------

# OpenTable Affiliate / Partner (Tier 1)
EXPO_PUBLIC_OPENTABLE_AFFILIATE_ID=

# Quandoo Partner (Tier 1)
EXPO_PUBLIC_QUANDOO_PARTNER_ID=

# Airalo eSIM Affiliate (ohne Key: kein BOOK_ESIM-Button)
EXPO_PUBLIC_AIRALO_AFFILIATE_ID=

# E-Mail-Versand: euer Backend (Supabase Edge Function / Resend-Proxy)
# POST JSON: { to, restaurantName, guestName, guestEmail, guestPhone, partySize, timeLabel }
EXPO_PUBLIC_RESERVATION_EMAIL_ENDPOINT=

# KI-Anruf: Webhook empfohlen (Keys bleiben auf dem Server)
# POST JSON: { restaurantName, restaurantPhone, guestName, partySize, timeLabel }
EXPO_PUBLIC_RESERVATION_AI_CALL_WEBHOOK=

# Optional: Vapi direkt aus der App (nur Dev — besser Webhook nutzen)
EXPO_PUBLIC_VAPI_API_KEY=
EXPO_PUBLIC_VAPI_ASSISTANT_ID=

# Optional: Bland.ai
EXPO_PUBLIC_BLAND_API_KEY=

# GetYourGuide Affiliate (Findus Partner)
EXPO_PUBLIC_GYG_PARTNER_ID=ZVQGONB

# Musement / TUI Affiliate
EXPO_PUBLIC_MUSEMENT_AFFILIATE_ID=findus-8445

# Uber Deep Links
EXPO_PUBLIC_UBER_CLIENT_ID=4a6yecXWLriTzMd4uqp41cVz2dDdlpSB

# Viator (TripAdvisor) Partner
EXPO_PUBLIC_VIATOR_PARTNER_ID=P00311883
EXPO_PUBLIC_VIATOR_MCID=42383

# Economy Bookings Mietwagen (Backup)
EXPO_PUBLIC_ECONOMY_BOOKINGS_REFERRAL_URL=https://www.economybookings.com/de/referral/16yupj/l0j2ln

# DiscoverCars Mietwagen (Primär — BOOK_CAR_RENTAL)
EXPO_PUBLIC_DISCOVER_CARS_AFFILIATE_URL=https://www.discovercars.com/?a_aid=Findus-Ai

# AWIN Publisher (Findus) + TravelSecure DE + travSIM DACH + Tiqets
EXPO_PUBLIC_AWIN_PUBLISHER_ID=3021215
# Optional: volle Tracking-URL überschreiben
# EXPO_PUBLIC_TRAVELSECURE_AFFILIATE_URL=https://www.awin1.com/cread.php?awinmid=106517&awinaffid=3021215&ued=https%3A%2F%2Fwww.travelsecure.de
# EXPO_PUBLIC_TRAVSIM_AFFILIATE_URL=https://www.awin1.com/cread.php?awinmid=15561&awinaffid=3021215&ued=https%3A%2F%2Ftravsim.com%2F
# Tiqets AWIN — Mid aus Merchant-Profil (Default 12428 Intl/US, bis ~6 %)
EXPO_PUBLIC_TIQETS_AWIN_MID=12428
# EXPO_PUBLIC_TIQETS_AFFILIATE_URL=
# Reservix DE Live-Events (AWIN mid=31293, ~2,5 % Warenkorb)
# EXPO_PUBLIC_RESERVIX_AWIN_MID=31293
# EXPO_PUBLIC_RESERVIX_AFFILIATE_URL=
# camping.info DE/AT (AWIN mid=44063)
# EXPO_PUBLIC_CAMPING_INFO_AFFILIATE_URL=
# Solmar DE Spanien-Bus/Pauschal (AWIN mid=114510)
# EXPO_PUBLIC_SOLMAR_AFFILIATE_URL=
# CHECK24 DE Pauschalreise (AWIN mid=9364)
# EXPO_PUBLIC_CHECK24_PACKAGE_AFFILIATE_URL=
# CHECK24 DE Mietwagen (AWIN mid=9364)
# EXPO_PUBLIC_CHECK24_CAR_AFFILIATE_URL=
# ab-in-den-urlaub DE/AT/CH (AWIN mid=9369 / 15612 / 15613) — Pauschal 3 %, Hotel 0,5 %
# EXPO_PUBLIC_AB_IN_DEN_URLAUB_AFFILIATE_URL=
# weg.de DE Pauschal/Last-Minute/Kurztrips (AWIN mid=12224)
# EXPO_PUBLIC_WEG_DE_AFFILIATE_URL=

# Bounce Gepäckaufbewahrung
EXPO_PUBLIC_BOUNCE_LUGGAGE_URL=https://go.bounce.com/FINDUS64751223710664

# Stay22 Unterkünfte (Backup / Live-Preis-API)
EXPO_PUBLIC_STAY22_AFFILIATE_ID=findus
# Optional: Stay22 Direct Travel API (live prices). Demo works without key (rate-limited).
# EXPO_PUBLIC_STAY22_API_KEY=

# Expedia Partnerize (Primär Unterkunft — Link-Builder)
EXPO_PUBLIC_EXPEDIA_CAMREF=1101l5Qcvp
EXPO_PUBLIC_EXPEDIA_CREATIVEREF=1100l86803
EXPO_PUBLIC_EXPEDIA_SITE_ID=20
# Optional: EXPO_PUBLIC_EXPEDIA_ADREF=

# Travelpayouts (Klook, Tiqets, Airalo, Transfers, …) — Marker aus Dashboard
EXPO_PUBLIC_TRAVELPAYOUTS_MARKER=760293

# Kokoro Offline-TTS – deutsches Martin-Modell
EXPO_PUBLIC_KOKORO_MODEL_URL=https://huggingface.co/Godelaune/Kokoro-82M-ONNX-German-Martin/resolve/main/kokoro-martin.onnx
EXPO_PUBLIC_KOKORO_VOICE_URL=https://huggingface.co/Godelaune/Kokoro-82M-ONNX-German-Martin/resolve/main/voices-martin.npz
# Optional:
# EXPO_PUBLIC_KOKORO_VOCAB_URL=

# ---------------------------------------------------------------------------
# Founder weekly report (npm run report:weekly) — Sonntag 08:00 Slack
# ---------------------------------------------------------------------------
# Play Console → Download reports → Financial → Cloud Storage bucket ID
# PLAY_REPORTS_BUCKET=pubsite_prod_rev_XXXXXXXX
# Service Account JSON (Play Console: Users & permissions → invite SA, Reports)
# PLAY_SERVICE_ACCOUNT_JSON=C:\path\to\play-reports-sa.json
# (or GOOGLE_APPLICATION_CREDENTIALS=...)
# PLAY_PACKAGE=de.findus.app
# PLAY_FEE_RATE=0.15
# PLAY_VAT_RATE=0.19
# # Kleinunternehmer: PLAY_VAT_RATE=0
# Optional API-Kosten-Override, falls device_cost_daily noch leer ist:
# WEEKLY_API_COST_EUR=12.50
# WEEKLY_GEMINI_CHARS_IN=0
# WEEKLY_GEMINI_CHARS_OUT=0
# WEEKLY_MAPS_CALLS=0
# WEEKLY_TTS_CHARS=0
# FOUNDER_REPORT_DAYS=7
# Fleet-Digest (npm run report:weekly-costs) braucht:
# SUPABASE_SERVICE_ROLE_KEY=...
# Cron: Sonntag 18:00 Berlin → GitHub workflow weekly-founder-digest.yml
